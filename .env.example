# Your Deriv app_id (see README for how to get one). 1089 is Deriv's shared demo
# app_id - it works for testing but is rate-limited and shared with everyone,
# so replace it with your own before relying on this for real trading.
DERIV_APP_ID=1089

# How many historical candles to load per symbol/timeframe on connect
HISTORY_COUNT=1000
